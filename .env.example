# Database
DATABASE_URL=postgresql+asyncpg://zendora:dev_password@localhost:5432/zendora

# JWT Authentication
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@zendora.com

# Admin Panel
# WARNING: Change these in production! Use strong passwords.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Third-Party Authentication
THIRD_PARTY_AUTH_URL=https://partner.com/verify
THIRD_PARTY_AUTH_TOKEN=optional-api-key

# Frontend
FRONTEND_URL=http://localhost:3000

# Environment
ENVIRONMENT=development
